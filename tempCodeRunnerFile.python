from typing import List

class Solution:
    def minimum_index(self, capacity: List[int], n: int) -> int:
       
        if not isinstance(capacity, list) or not all(isinstance(x, int) for x in capacity):
            raise ValueError("capacity must be a list of integers.")
        if n <= 0 or n != len(capacity):
            raise ValueError("n must match the length of capacity and be > 0.")

        left, right = 0, n - 1

        while left < right:
            mid = (left + right) // 2

            
            if capacity[mid] > capacity[right]:
                left = mid + 1
            else:
               
                right = mid

        return left 


